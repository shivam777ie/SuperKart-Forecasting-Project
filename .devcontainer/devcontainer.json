{
  "name": "SuperKart Sales Forecasting Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {
      "label": "Flask Backend API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8501": {
      "label": "Streamlit Frontend UI",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "echo 'SuperKart Codespace Ready. Run docker compose up -d --build to launch services.'"
}
